# Copiez ce fichier en .env et renseignez vos valeurs (ne commitez jamais .env)

# Clé API NVIDIA (https://build.nvidia.com/)
NVIDIA_API_KEY=votre_cle_api_ici

# Optionnel — valeurs par défaut ci-dessous
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
